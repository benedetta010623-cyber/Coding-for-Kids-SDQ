{
  "entities": {
    "student": {
      "title": "Student Profile",
      "description": "Student details and profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "class": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "uid": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] }
      },
      "required": ["name", "class", "uid", "role"]
    },
    "project": {
      "title": "Student Project",
      "description": "Project details submitted by students",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "link": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "scratch", "document", "other"] },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "title", "category", "type", "status", "createdAt"]
    },
    "curriculum": {
      "title": "Curriculum Item",
      "description": "Modules and lessons for the classes",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "semester": { "type": "number" },
        "duration": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "coming_soon"] }
      },
      "required": ["title", "semester", "order", "status"]
    },
    "gallery": {
      "title": "Gallery Activity",
      "description": "Activities gallery uploaded by admin",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "likes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "userId": { "type": "string" },
              "userName": { "type": "string" },
              "text": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" }
            },
            "required": ["id", "userId", "userName", "text", "createdAt"]
          }
        }
      },
      "required": ["title", "imageUrl", "createdAt"]
    }
  },
  "firestore": {
    "students": {
      "schema": "student",
      "description": "Collection of student profiles"
    },
    "projects": {
      "schema": "project",
      "description": "Collection of all student projects"
    },
    "curriculum": {
      "schema": "curriculum",
      "description": "Course modules for each semester"
    },
    "gallery": {
      "schema": "gallery",
      "description": "Collection of gallery activities"
    }
  }
}
